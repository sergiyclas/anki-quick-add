# video.config - Anki Quick Add feature tour (YouTube, 16:9)

# --- Format ------------------------------------------------------------------
OUT_W=1920
OUT_H=1080
RENDER_W=1920
RENDER_H=1080
FPS=30

# --- Motion ------------------------------------------------------------------
ZOOM_MAX=1.06
FADE=0.35

# --- Timing ------------------------------------------------------------------
TAIL_SECONDS=0.6

# --- Narration ---------------------------------------------------------------
TTS_ENGINE=edge-tts
EDGE_VOICE=en-US-AndrewNeural
ELEVENLABS_VOICE_ID=
AUDIO_KBPS=64

# --- Script ------------------------------------------------------------------
SCRIPT_MD=video/script.md

# --- Subtitles ---------------------------------------------------------------
SUBS_FONT=Arial
SUBS_FONTSIZE=15
SUBS_MARGINV=22
SUBS_MAX_LINE=48

# --- Output ------------------------------------------------------------------
FINAL_NAME=anki-quick-add-demo
TARGET_MIB=0
LIMIT_MIB=0
PUBLISH_DIR=
